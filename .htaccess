# MailDart (core PHP) — Apache settings
DirectoryIndex index.php
Options -Indexes

# Clean URLs: /recipients instead of index.php?page=recipients, /api/preview instead of api/preview.php
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- 1. Browser asked for an old ".php" URL -> 301 to the clean URL (GET only, so form POSTs never break)
    #        index.php?page=… is redirected by index.php itself (it needs to read the query string).
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/([^?\s]*/)?sitemap\.php[\s?]
    RewriteRule ^ /%1sitemap.xml [R=301,L]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/([^?\s]*/)?robots\.php[\s?]
    RewriteRule ^ /%1robots.txt [R=301,L]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.php[\s?]
    RewriteCond %1 !(^|/)index$
    RewriteRule ^ /%1 [R=301,L,NE]

    # --- 2. Drop a trailing slash on clean URLs (/recipients/ -> /recipients) so relative links keep working
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^ %1 [R=301,L]

    # --- 3. SEO files are generated by PHP so they always contain the correct site URL
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]

    # --- 4. /something -> something.php when that file exists (api/preview, api/dispatch-tick, …)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L]

    # --- 5. /overview, /login, /recipients, … -> index.php?page=… (query string kept)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z]+)$ index.php?page=$1 [QSA,L]
</IfModule>

# Never serve dotfiles (.env, .git, .htaccess) or config/docs that live in the web root
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(md|json|lock|sql|log|example)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Large Excel uploads / long AI generations
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 180
</IfModule>
