# MailDart (core PHP) — Apache settings
DirectoryIndex index.php
Options -Indexes

# Clean URLs: /recipients instead of index.php?page=recipients, /api/preview instead of api/preview.php
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- 1. Browser asked for an old ".php" URL -> 301 to the clean URL (GET only, so form POSTs never break)
    #        index.php?page=… is redirected by index.php itself (it needs to read the query string).
    #        Old sitemap.php / robots.php links go to the static sitemap.xml / robots.txt files.
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/([^?\s]*/)?sitemap\.php[\s?]
    RewriteRule ^ /%1sitemap.xml [R=301,L]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/([^?\s]*/)?robots\.php[\s?]
    RewriteRule ^ /%1robots.txt [R=301,L]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.php[\s?]
    RewriteCond %1 !(^|/)index$
    RewriteRule ^ /%1 [R=301,L,NE]

    # --- 2. Drop a trailing slash on clean URLs (/recipients/ -> /recipients) so relative links keep working
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^ %1 [R=301,L]

    # --- 3. sitemap.xml and robots.txt are real static files (regenerate: php tools/build-seo-files.php)

    # --- 4. /something -> something.php when that file exists (api/preview, api/dispatch-tick, …)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L]

    # --- 5. /overview, /login, /recipients, … -> index.php?page=… (query string kept)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z]+)$ index.php?page=$1 [QSA,L]

    # --- 6. Anything else that does not exist -> the app's own 404 page (real 404 status, noindex)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php?page=404 [L]
</IfModule>

# Force HTTPS on a live server (uncomment once an SSL certificate is installed)
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} off
#     RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

# Never serve dotfiles (.env, .git, .htaccess) or config/docs that live in the web root
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(md|json|lock|sql|log|example)$">
    Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/x-icon .ico

# Compression (smaller pages = faster = better Core Web Vitals)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>

# Browser caching. CSS/JS/images are versioned with ?v=<mtime>, so they can be cached for a year.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Large Excel uploads / long AI generations
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 180
</IfModule>
