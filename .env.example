# Copy this file to .env and fill in your values.

# --- MySQL (XAMPP defaults) ---------------------------------------------------
# The database and tables are created automatically on first run.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maildart
DB_USER=root
DB_PASS=

# --- App ------------------------------------------------------------------------
# Public URL of the app (used in password-reset links). Leave empty to auto-detect.
APP_URL=
APP_TIMEZONE=Asia/Kolkata
# Secret used to encrypt saved SMTP passwords. Leave empty to auto-generate storage/app.key.
APP_KEY=

# --- AI template generator (optional) -------------------------------------------
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# NVIDIA NIM (e.g. meta/llama-3.3-70b-instruct): https://build.nvidia.com
NVIDIA_API_KEY=

# --- System mail account for "Forgot password" emails (optional) ----------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MailDart

# --- Sign in with Google (optional) ---------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI:  <your APP_URL>google-auth   e.g. http://localhost/core/MailDart/google-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google reCAPTCHA v3 (optional) — protects Sign in, Sign up and Forgot password
# https://www.google.com/recaptcha/admin  (type: Score based / v3; add your domain, e.g. localhost)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# 0.0 (bot) … 1.0 (human); requests below this score are rejected
RECAPTCHA_MIN_SCORE=0.5

# --- SEO (optional) ------------------------------------------------------------
# After changing APP_URL for a live domain run:  php tools/build-seo-files.php  (rewrites sitemap.xml + robots.txt)
APP_NAME=MailDart Pro
# Custom share image (default: assets/img/og-image.png, 1200x630)
SEO_OG_IMAGE=
SEO_TWITTER_HANDLE=
# Social profiles for structured data, comma separated
SEO_ORG_SAME_AS=
# Search Console / Bing Webmaster verification codes (content of the meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
